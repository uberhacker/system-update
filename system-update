#!/bin/bash
OS=
[ -f /etc/redhat-release ] && OS="RedHat"
[ -f /etc/system-release ] && OS="CentOS"
[ -f /etc/debian_version ] && OS="Debian"
if [ -z "$OS" ]; then
  echo "Operating system not supported."
  exit 1
fi
CONFIRM="-y"
if test $1; then
  if [[ $1 == "-d" || $1 == "--dry-run" ]]; then
    CONFIRM="-n"
  else
    echo "Usage: $0 [-d | --dry-run]"
    exit 1
  fi
fi
# Get the 7 character commit hash of the latest release.
function get_release_commit() {
  TAG_NAME=$(curl -s https://api.github.com/repos/${1}/releases/latest | jq -r '.tag_name')
  TAG_SHA=$(curl -s https://api.github.com/repos/${1}/git/ref/tags/${TAG_NAME} | jq -r '.object.sha')
  OBJECT_TYPE=$(curl -s https://api.github.com/repos/${1}/git/ref/tags/${TAG_NAME} | jq -r '.object.type')
  if [ "$OBJECT_TYPE" = "commit" ]; then
    echo ${TAG_SHA:0:7}
  else
    # Fetch the actual commit SHA from the tag object.
    OBJ_SHA=$(curl -s https://api.github.com/repos/{owner}/{repo}/git/tags/$TAG_SHA | jq -r '.object.sha')
    echo ${OBJ_SHA:0:7}
  fi
  exit
}
if [ $OS == "Debian" ]; then
  sudo apt-get update
  if [ $CONFIRM == "-y" ]; then
    sudo apt-get dist-upgrade -y --allow-unauthenticated
    sudo apt-get -f install
    sudo apt-get autoremove --purge -y
    sudo apt-get clean
  else
    sudo apt-get dist-upgrade --assume-no
    exit
  fi
else
  sudo yum update $CONFIRM
  if [ $CONFIRM == "-y" ]; then
    sudo yum autoremove -y
    sudo yum clean all
  fi
fi
if [ $CONFIRM == "-y" ]; then
  if [ $OS == "Debian" ]; then
    [ -z "$(command -v jq 2> /dev/null)" ] && sudo apt update && sudo apt install jq -y
    CODIUM=$(command -v codium 2> /dev/null)
    if [ -n "$CODIUM" ]; then
      echo "Start codium update -------------------------------------"
      INSTALLED_RELEASE=$(codium -v | head -1)
      LATEST_RELEASE=$(curl https://api.github.com/repos/VSCodium/vscodium/releases/latest -s | jq .name -r)
      echo "codium current version is $INSTALLED_RELEASE"
      echo "codium latest release is $LATEST_RELEASE"
      if [ "$INSTALLED_RELEASE" != "$LATEST_RELEASE" ]; then
        if [ -z "$(dpkg -l | grep codium)" ]; then
          echo "Unable to update since codium was not installed via deb package."
        else
          echo "Updating codium..."
          case "$(uname -m)" in
            aarch64|arm64|arm8) ARCH="arm64";;
             arm|armv6l|armv7l) ARCH="armhf";;
                    x64|x86_64) ARCH="amd64";;
                             *) ARCH="unknown";;
          esac
          if [ $ARCH == "unknown" ]; then
            echo "Unable to update. Architecture $(uname -m) is not supported."
          else
            CODIUM_DEB="codium_${LATEST_RELEASE}_${ARCH}.deb"
            curl -L https://github.com/VSCodium/vscodium/releases/download/${LATEST_RELEASE}/${CODIUM_DEB} -o /tmp/${CODIUM_DEB}
            sudo dpkg -i /tmp/${CODIUM_DEB}
            rm -f /tmp/${CODIUM_DEB}
            echo "Updated codium from $INSTALLED_RELEASE to $LATEST_RELEASE."
          fi
        fi
      else
        echo "codium is already up to date."
      fi
      echo "End codium update ---------------------------------------"
    fi
  fi
  # This makes sure sudo is not required to update.
  sudo chown -R $(whoami):$(whoami) /usr/local/bin
  AGY=$(command -v agy 2> /dev/null)
  if [ -n "$AGY" ]; then
    echo "Start agy update ----------------------------------------"
    agy update
    echo "End agy update ------------------------------------------"
  fi
  ANYTHINGLLM=$(command -v AnythingLLMDesktop.AppImage 2> /dev/null)
  if [ -n "$ANYTHINGLLM" ]; then
    echo "Start AnythingLLMDesktop update -------------------------"
    INSTALLED_RELEASE=$(AnythingLLMDesktop.AppImage --appimage-version 2>&1 | cut -d: -f2 | xargs)
    LATEST_RELEASE=$(get_release_commit "Mintplex-Labs/anything-llm")
    echo "AnythingLLMDesktop current version is $INSTALLED_RELEASE"
    echo "AnythingLLMDesktop latest release is $LATEST_RELEASE"
    if [ "$INSTALLED_RELEASE" != "$LATEST_RELEASE" ]; then
      echo "Updating AnythingLLMDesktop..."
      export ANYTHING_LLM_INSTALL_DIR="${ANYTHINGLLM%/*}" && curl -fsSL https://cdn.anythingllm.com/latest/installer.sh | bash
    fi
    echo "End AnythingLLMDesktop update ---------------------------"
  fi
  CLAUDE=$(command -v claude 2> /dev/null)
  if [ -n "$CLAUDE" ]; then
    echo "Start claude update -------------------------------------"
    INSTALLED_RELEASE="v$(claude -v | cut -d' ' -f1)"
    LATEST_RELEASE=$(curl https://api.github.com/repos/anthropics/claude-code/releases/latest -s | jq .tag_name -r)
    echo "claude current version is $INSTALLED_RELEASE"
    echo "claude latest release is $LATEST_RELEASE"
    if [ "$INSTALLED_RELEASE" != "$LATEST_RELEASE" ]; then
      claude update
    else
      echo "claude is already up to date."
    fi
    echo "End claude update ---------------------------------------"
  fi
  CODEX=$(command -v codex 2> /dev/null)
  if [ -n "$CODEX" ]; then
    echo "Start codex update --------------------------------------"
    INSTALLED_RELEASE="v$(codex -V | cut -d' ' -f2)"
    LATEST_RELEASE=$(curl https://api.github.com/repos/openai/codex/releases/latest -s | jq .tag_name -r | cut -d- -f2)
    echo "codex current version is $INSTALLED_RELEASE"
    echo "codex latest release is $LATEST_RELEASE"
    if [ "$INSTALLED_RELEASE" != "$LATEST_RELEASE" ]; then
      codex update
    else
      echo "codex is already up to date."
    fi
    echo "End codex update ----------------------------------------"
  fi
  COMPOSER=$(command -v composer 2> /dev/null)
  if [ -n "$COMPOSER" ]; then
    echo "Start composer update -----------------------------------"
    INSTALLED_RELEASE=$(composer -V | cut -d' ' -f3)
    LATEST_RELEASE=$(curl https://api.github.com/repos/composer/composer/releases/latest -s | jq .name -r)
    echo "composer current version is $INSTALLED_RELEASE"
    echo "composer latest release is $LATEST_RELEASE"
    if [ "$INSTALLED_RELEASE" != "$LATEST_RELEASE" ]; then
      echo "Updating composer..."
      $COMPOSER self-update
      echo "Updating composer global projects..."
      $COMPOSER global update
      CGR=$(command -v cgr 2> /dev/null)
      if [ -n "$CGR" ]; then
        echo "Updating cgr projects..."
        $CGR update
      fi
      DRUSH=$(command -v drush-versions 2> /dev/null)
      if [ -n "$DRUSH" ]; then
        echo "Updating drush projects..."
        $DRUSH up
      fi
      $COMPOSER clearcache
    else
      echo "composer is already up to date."
    fi
    echo "End composer update -------------------------------------"
  fi
  COPILOT=$(command -v copilot 2> /dev/null)
  if [ -n "$COPILOT" ]; then
    echo "Start copilot update ------------------------------------"
    INSTALLED_RELEASE="v$(copilot -v | head -1 | cut -d' ' -f4)"
    LATEST_RELEASE=$(curl https://api.github.com/repos/github/copilot-cli/releases/latest -s | jq .tag_name -r)
    echo "copilot current version is $INSTALLED_RELEASE"
    echo "copilot latest release is $LATEST_RELEASE"
    if [ "$INSTALLED_RELEASE" != "$LATEST_RELEASE" ]; then
      copilot update
    else
      echo "copilot is already up to date."
    fi
    echo "End copilot update --------------------------------------"
  fi
  DEVIN=$(command -v devin 2> /dev/null)
  if [ -n "$DEVIN" ]; then
    echo "Start devin update --------------------------------------"
    devin update
    echo "End devin update ----------------------------------------"
  fi
  COMPOSE=$(command -v docker-compose 2> /dev/null)
  if [ -n "$COMPOSE" ]; then
    if [[ "$(readlink -f $COMPOSE)" != *"docker-desktop"* ]]; then
      echo "Start docker-compose update -----------------------------"
      INSTALLED_RELEASE=$(docker-compose -v | cut -d' ' -f4)
      LATEST_RELEASE=$(curl https://api.github.com/repos/docker/compose/releases/latest -s | jq .tag_name -r)
      echo "docker-compose current version is $INSTALLED_RELEASE"
      echo "docker-compose latest release is $LATEST_RELEASE"
      if [ -n "$(dpkg -l | grep docker-compose-plugin)" ]; then
        sudo ln -sf /usr/libexec/docker/cli-plugins/docker-compose /usr/local/bin/docker-compose
        if [ "$INSTALLED_RELEASE" != "$LATEST_RELEASE" ]; then
          echo "Updated docker-compose $INSTALLED_RELEASE to $LATEST_RELEASE."
        else
          echo "docker-compose is already up to date."
        fi
      else
        if [ "$INSTALLED_RELEASE" != "$LATEST_RELEASE" ]; then
          case "$(uname -m)" in
            aarch64|arm64|arm8) ARCH="aarch64";;
                  armv6|armv6l) ARCH="armv6";;
              arm|armv7|armv7l) ARCH="armv7";;
             ppc|ppc64|ppc64le) ARCH="ppc64le";;
                  risc|riscv64) ARCH="riscv64";;
            s390|s390x|s390x64) ARCH="s390x";;
                    x64|x86_64) ARCH="x86_64";;
                             *) ARCH="unknown";;
          esac
          if [ $ARCH == "unknown" ]; then
            echo "Unable to update. Architecture $(uname -m) is not supported."
          else
            echo "Updating docker-compose..."
            curl -L https://github.com/docker/compose/releases/download/${LATEST_RELEASE}/docker-compose-linux-${ARCH} | sudo tee /usr/local/bin/docker-compose
            sudo chmod +x /usr/local/bin/docker-compose
            echo "Updated docker-compose $INSTALLED_RELEASE to $LATEST_RELEASE."
          fi
        else
          echo "docker-compose is already up to date."
        fi
      fi
      echo "End docker-compose update -------------------------------"
    fi
  fi
  GROK=$(command -v grok 2> /dev/null)
  if [ -n "$GROK" ]; then
    echo "Start grok update ---------------------------------------"
    grok update
    echo "End grok update -----------------------------------------"
  fi
  HERMES=$(command -v hermes 2> /dev/null)
  if [ -n "$HERMES" ]; then
    echo "Start hermes update -------------------------------------"
    INSTALLED_RELEASE=$(hermes -V | head -1 | cut -d' ' -f3)
    LATEST_RELEASE=$(curl https://api.github.com/repos/NousResearch/hermes-agent/releases/latest -s | jq .tag_name -r)
    echo "hermes current version is $INSTALLED_RELEASE"
    echo "hermes latest release is $LATEST_RELEASE"
    if [ "$INSTALLED_RELEASE" != "$LATEST_RELEASE" ]; then
      hermes update
    else
      echo "hermes is already up to date."
    fi
    echo "End hermes update ---------------------------------------"
  fi
  KILO=$(command -v kilo 2> /dev/null)
  if [ -n "$KILO" ]; then
    echo "Start kilo update ---------------------------------------"
    INSTALLED_RELEASE="v$(kilo -v)"
    LATEST_RELEASE=$(curl https://api.github.com/repos/Kilo-Org/kilocode/releases/latest -s | jq .tag_name -r)
    echo "kilo current version is $INSTALLED_RELEASE"
    echo "kilo latest release is $LATEST_RELEASE"
    if [ "$INSTALLED_RELEASE" != "$LATEST_RELEASE" ]; then
      kilo upgrade
    else
      echo "kilo is already up to date."
    fi
    echo "End kilo update -----------------------------------------"
  fi
  NODEBREW=$(command -v nodebrew 2> /dev/null)
  if [ -n "$NODEBREW" ]; then
    echo "Start nodebrew update -----------------------------------"
    CURRENT=$($NODEBREW ls | grep ^current | cut -d':' -f2 | xargs)
    MAJOR=$(echo $CURRENT | cut -d'.' -f1)
    LATEST=$($NODEBREW ls-remote | grep $MAJOR. | xargs | awk 'NF>1{print $NF}')
    echo "nodebrew current version is $CURRENT"
    echo "nodebrew latest release is $LATEST"
    if [ "$LATEST" != "$CURRENT" ]; then
      echo "Updating node..."
      NPM=$(command -v npm 2> /dev/null)
      GULP=$(command -v gulp 2> /dev/null)
      YARN=$(command -v yarn 2> /dev/null)
      $NODEBREW install $LATEST
      $NODEBREW use $LATEST
      $NODEBREW uninstall $CURRENT
      [ -n "$NPM" ] && npm i -g npm
      [ -n "$GULP" ] && npm i -g gulp
      [ -n "$YARN" ] && npm i -g yarn
    else
      echo "nodebrew is already up to date."
    fi
    echo "End nodebrew update -------------------------------------"
  fi
  NVM_DIR="$HOME/.nvm"
  if [ -d $NVM_DIR ]; then
    echo "Start node update ---------------------------------------"
    [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"  # This loads nvm
    USED_OLD=$(nvm current)
    MAJOR=$(nvm current | cut -d'.' -f1)
    CURRENT="stable"
    if [ "$MAJOR" == "v4" ]; then
      CURRENT="lts/argon"
    fi
    if [ "$MAJOR" == "v6" ]; then
      CURRENT="lts/boron"
    fi
    if [ "$MAJOR" == "v8" ]; then
      CURRENT="lts/carbon"
    fi
    nvm install iojs
    nvm install --lts=argon
    nvm install --lts=boron
    nvm install --lts=carbon
    nvm install stable
    nvm use $CURRENT
    USED_NEW=$(nvm current)
    echo "nvm current version is $USED_OLD"
    echo "nvm latest release is $USED_NEW"
    if [ "$USED_OLD" != "$USED_NEW" ]; then
      nvm uninstall $USED_OLD
    else
      echo "nvm is already up to date."
    fi
    echo "End node update -----------------------------------------"
  fi
  OLLAMA=$(command -v ollama 2> /dev/null)
  if [ -n "$OLLAMA" ]; then
    echo "Start ollama update -------------------------------------"
    INSTALLED_RELEASE="v$(ollama -v | cut -d' ' -f4)"
    LATEST_RELEASE=$(curl https://api.github.com/repos/ollama/ollama/releases/latest -s | jq .tag_name -r)
    echo "ollama current version is $INSTALLED_RELEASE"
    echo "ollama latest release is $LATEST_RELEASE"
    if [ "$INSTALLED_RELEASE" != "$LATEST_RELEASE" ]; then
      curl -fsSL https://ollama.com/install.sh | bash
    else
      echo "ollama is already up to date."
    fi
    echo "End ollama update ---------------------------------------"
  fi
  OMP=$(command -v omp 2> /dev/null)
  if [ -n "$OMP" ]; then
    echo "Start omp update ----------------------------------------"
    INSTALLED_RELEASE="v$(omp -v | cut -d$'/' -f2)"
    LATEST_RELEASE=$(curl https://api.github.com/repos/can1357/oh-my-pi/releases/latest -s | jq .tag_name -r)
    echo "omp current version is $INSTALLED_RELEASE"
    echo "omp latest release is $LATEST_RELEASE"
    if [ "$INSTALLED_RELEASE" != "$LATEST_RELEASE" ]; then
      omp update
    else
      echo "omp is already up to date."
    fi
    echo "End omp update ------------------------------------------"
  fi
  PIP=$(command -v pip 2> /dev/null)
  if [ -n "$PIP" ]; then
    echo "Start pip update ----------------------------------------"
    if [ $PIP == $HOME/.local/bin/pip ]; then
      $PIP install -U pip --user
    else
      echo "Unable to update pip since it is not installed for the local user."
    fi
    AWS=$(command -v aws 2> /dev/null)
    if [ -n "$AWS" ]; then
      echo "Start aws update ----------------------------------------"
      if [ $AWS == $HOME/.local/bin/aws ]; then
        $PIP install -U awscli --user
      else
        echo "Unable to update aws since it is not installed for the local user."
      fi
      echo "End aws update ------------------------------------------"
    fi
    echo "End pip update ------------------------------------------"
  fi
  QWEN=$(command -v qwen 2> /dev/null)
  if [ -n "$QWEN" ]; then
    echo "Start qwen update --------------------------------------"
    INSTALLED_RELEASE="v$(qwen -v 2> /dev/null)"
    LATEST_RELEASE=$(curl -s https://api.github.com/repos/QwenLM/qwen-code/tags?per_page=100 | jq -r '.[].name' | grep -E '^v?[0-9]+\.[0-9]+\.[0-9]+$' | sort -V | tail -n 1)
    echo "qwen current version is $INSTALLED_RELEASE"
    echo "qwen latest release is $LATEST_RELEASE"
    if [ "$INSTALLED_RELEASE" != "$LATEST_RELEASE" ]; then
      qwen update
    else
      echo "qwen is already up to date."
    fi
    echo "End qwen update ----------------------------------------"
  fi
  RVM=$(command -v rvm 2> /dev/null)
  if [ -n "$RVM" ]; then
    echo "Start rvm update ---------------------------------------"
    INSTALLED_RELEASE=$(rvm -v 2> /dev/null | cut -d' ' -f2)
    LATEST_RELEASE=$(curl https://api.github.com/repos/rvm/rvm/releases/latest -s | jq .name -r)
    echo "rvm current version is $INSTALLED_RELEASE"
    echo "rvm latest release is $LATEST_RELEASE"
    if [ "$INSTALLED_RELEASE" != "$LATEST_RELEASE" ]; then
      $RVM get stable
    else
      echo "rvm is already up to date."
    fi
    echo "End rvm update -----------------------------------------"
  fi
  TERMINUS=$(command -v terminus 2> /dev/null)
  if [ -n "$TERMINUS" ]; then
    echo "Start terminus update ----------------------------------"
    INSTALLED_RELEASE=$(terminus -V 2> /dev/null | cut -d' ' -f2)
    LATEST_RELEASE=$(curl https://api.github.com/repos/pantheon-systems/terminus/releases/latest -s | jq .name -r)
    echo "terminus current version is $INSTALLED_RELEASE"
    echo "terminus latest release is $LATEST_RELEASE"
    if [ "$INSTALLED_RELEASE" != "$LATEST_RELEASE" ]; then
      echo "Updating terminus..."
      $TERMINUS self:update
    else
      echo "terminus is already up to date."
    fi
    echo "End terminus update ------------------------------------"
  fi
  UV=$(command -v uv 2> /dev/null)
  if [ -n "$UV" ]; then
    echo "Start uv update ----------------------------------------"
    INSTALLED_RELEASE=$(uv self version 2> /dev/null | cut -d' ' -f2)
    LATEST_RELEASE=$(curl https://api.github.com/repos/astral-sh/uv/releases/latest -s | jq .name -r)
    echo "uv current version is $INSTALLED_RELEASE"
    echo "uv latest release is $LATEST_RELEASE"
    if [ "$INSTALLED_RELEASE" != "$LATEST_RELEASE" ]; then
      uv self update
    else
      echo "uv is already up to date."
    fi
    echo "End uv update ------------------------------------------"
  fi
  VIM=$(command -v vim 2> /dev/null)
  if [[ -n "$VIM" && -d ~/.vim/.git ]]; then
    echo "Start vim update ---------------------------------------"
    cd ~/.vim && git submodule foreach git pull && cd -
    echo "End vim update -----------------------------------------"
  fi
  WP=$(command -v wp 2> /dev/null)
  if [ -n "$WP" ]; then
    echo "Start wp update ----------------------------------------"
    INSTALLED_RELEASE=$(wp cli version 2> /dev/null | cut -d' ' -f2)
    LATEST_RELEASE=$(curl https://api.github.com/repos/wp-cli/wp-cli/releases/latest -s | jq .name -r | cut -d' ' -f2)
    echo "wp cli current version is $INSTALLED_RELEASE"
    echo "wp cli latest release is $LATEST_RELEASE"
    if [ "$INSTALLED_RELEASE" != "$LATEST_RELEASE" ]; then
      $WP cli update --yes
    else
      echo "wp is already up to date."
    fi
    echo "End wp update ------------------------------------------"
  fi
  ZCMDS=$(command -v zcmds 2> /dev/null)
  if [ -n "$ZCMDS" ]; then
    echo "Start zcmds update -------------------------------------"
    pipx upgrade zcmds
    echo "End zcmds update ---------------------------------------"
  fi
fi
