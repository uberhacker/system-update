#!/usr/bin/env bash
# Backward-compatible wrapper: `./system-update` from a checkout, or a copy of
# this file next to a bin/ directory, runs the real entry point in bin/.
self="$0"
while [ -L "$self" ]; do
  dir=$(cd -P "$(dirname "$self")" && pwd)
  self=$(readlink "$self")
  case "$self" in /*) ;; *) self="$dir/$self" ;; esac
done
exec "$(cd -P "$(dirname "$self")" && pwd)/bin/system-update" "$@"
